                "city": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "postalCode": {
                  "type": "string",
                  "minLength": 1
                },
                "countryCode": {
                  "type": "string",
                  "minLength": 1,
                  "description": "2-character country code (ISO 3166-1 alpha-2)"
                },
                "storeName": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the store"
                },
                "locatedIn": {
                  "type": "string",
                  "description": "Business or venue the merchant is inside"
